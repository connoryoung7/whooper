# Copy to .env for local development. In Dokploy, set these in the application's Environment tab.

# From https://developer-dashboard.whoop.com (create an app; enable all read scopes).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the WHOOP app.
WHOOP_REDIRECT_URL=http://localhost:8080/auth/callback

# Protects /auth/login and /status (HTTP Basic auth; any username).
ADMIN_PASSWORD=

PORT=8080

# Postgres. DATABASE_URL takes precedence; in Dokploy use the database's Internal Connection URL.
# DATABASE_URL=postgres://user:pass@host:5432/whooper?sslmode=disable
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_DATABASE=whooper
BLUEPRINT_DB_USERNAME=whooper
BLUEPRINT_DB_PASSWORD=whooper
BLUEPRINT_DB_SCHEMA=public

# Incremental syncs re-read this many days before the last successful sync, to catch records
# WHOOP scores or edits after the fact. Full syncs catch everything older.
SYNC_LOOKBACK_DAYS=14
